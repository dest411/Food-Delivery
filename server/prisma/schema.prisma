generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Product видалили, він нам не треба

model Order {
  id        Int      @id @default(autoincrement()) 
  name      String
  phone     String
  address   String
  total     Int      
  status    String   @default("new") 
  items     Json     
  createdAt DateTime @default(now())
}